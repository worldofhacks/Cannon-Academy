# Both forms: worktrees carry `node_modules` as a symlink, which `node_modules/` misses.
node_modules
node_modules/
coverage/
dist/
.expo/
*.log
.DS_Store

# Firebase/Expo public client configuration is provisioned locally and through EAS.
.env
.env.local
