# Swarm control state — per worktree, never shared
.worktrees/
.tdd-swarm/phase
.tdd-swarm/active-ticket

# Agent scratch space: throwaway reference implementations and mutation harnesses.
# Never committed, so nothing built here can be mistaken for production code.
scratchpad/
.tdd-swarm/.doc-align-pushes

# Generated native projects. This is a Continuous Native Generation project: `app.json` plus the
# config plugins ARE the source of truth, and `npx expo prebuild` regenerates both directories
# from them. Committing them means the next person edits Xcode settings that the following
# prebuild silently overwrites.
/ios/
/android/

