{
  "name": "cannon-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Cannon Academy — K-5 math duels on the high seas. Pure-TS game engine core.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
