{
  "expo": {
    "name": "Cannon Academy",
    "slug": "cannon-academy",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cannonacademy",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.worldofhacks.cannonacademy"
    },
    "android": {
      "package": "com.worldofhacks.cannonacademy",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C5E86",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be5be296-c153-4619-81ea-423c51a84ae8"
      }
    },
    "owner": "worldofhacks"
  }
}
